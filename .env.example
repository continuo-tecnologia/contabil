# Copy to .env (gitignored). Compose reads this file; nothing else does.
CTN_ENV=staging
COMPOSE_FILE=compose.yaml
DOMAIN=continuo.dev.br

# Laptop:
# CTN_ENV=local
# COMPOSE_FILE=compose.yaml:compose.local.yaml
# DOMAIN=localhost

# Notas fiscais para a Colinear (docs/notas-colinear.md). Valores reais só no .env do servidor.
# O token do leitor `financeiro` de WFM_INTERFACE_TOKENS no .env do OWP (32+ caracteres).
OWP_NOTAS_TOKEN=
# Opcional: onde está o notas.htpasswd (usuário e senha da Colinear em /notas). Padrão: /srv/contabil/notas.htpasswd
# NOTAS_HTPASSWD=
